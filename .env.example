# Required — get from Discord Developer Portal
DISCORD_TOKEN=

# Required — used to encrypt per-server API keys (min 8 chars, make it long and random)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_SECRET=

# Optional — bot owner ID(s), comma-separated (grants full access everywhere)
# OWNER_ID=123456789012345678
# OWNERS=123456789012345678,987654321098765432

# Optional — default command channel (bot always responds here)
# COMMAND_CHANNEL_ID=

# Optional — global fallback LLM config (used when a guild hasn't set its own key)
# Best free + fast option: Groq + DeepSeek-R1-Distill-Llama-70B
#   - Free: 5 billion tokens/day, no waitlist, get key at https://console.groq.com/keys
#   - Speed: ~1500 tokens/sec on Groq's LPU
#   - OpenAI-compatible: just set LLM_BASE_URL + LLM_MODEL
# Get a free key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=deepseek-r1-distill-llama-70b
LLM_TEMPERATURE=0.4

# Optional — default respond mode: mention | all | command
# RESPOND_MODE=mention

# Optional — max agent loop steps (1-6)
# MAX_STEPS=3
