# Copy this file to .env and fill in your values

# ---- Discord ----
DISCORD_TOKEN=your-discord-bot-token

# Owner(s): comma-separated list of user IDs and/or usernames (either works).
# Owners can ALWAYS run destructive/moderation actions. Anyone with Discord mod
# permissions (Administrator / Manage Server / Ban / Kick / Timeout) also counts as staff.
# e.g. OWNERS=123456789012345678,cooluser
OWNERS=123456789012345678

# Optional: a "command channel" the bot always listens in (any message, no @mention needed).
# Leave blank if you only want mention/DM based interaction.
COMMAND_CHANNEL_ID=1234567890123456789

# How the bot decides which messages to answer:
#   mention  (default) — replies to @mentions, DMs, replies to the bot, and the command channel
#   all                — replies to EVERY human message in every channel it can see (chatty!)
#   command            — ONLY the command channel (classic behaviour)
RESPOND_MODE=mention

# ---- Secrets encryption ----
# REQUIRED. Long random string used to encrypt per-server LLM API keys at rest
# (AES-256-GCM). If you change it, previously stored server keys become unreadable.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_SECRET=change-me-to-a-long-random-string

# ---- LLM: Mistral (free tier) ----
# GLOBAL FALLBACK key — used only by servers that haven't set their own key
# via /config setkey. Leave blank to force every server to bring its own key.
# 1. Sign up at https://console.mistral.ai (free, no card needed)
# 2. Choose the FREE "Experiment" plan when asked
# 3. Go to "API Keys" -> Create new key -> paste it below
# Free-tier models: mistral-small-latest (recommended), open-mistral-nemo
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest

# Personality warmth vs. determinism (0 = robotic/precise, 1 = creative). 0.4 is a good default.
LLM_TEMPERATURE=0.4

# Max agent reasoning steps per message (plan -> act -> see results -> re-plan). 1-6.
MAX_STEPS=3

# The API is OpenAI-compatible, so other providers also work if you ever switch:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=llama-3.3-70b-versatile
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.1   (API key can be "ollama")
