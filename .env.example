# Copy this file to .env and fill in your values

# ---- Discord ----
DISCORD_TOKEN=your-discord-bot-token

# Owner: comma-separated list of user IDs and/or usernames (either works)
# e.g. OWNERS=123456789012345678,cooluser
OWNERS=123456789012345678

# The "default" command channel where the bot listens for owner prompts
COMMAND_CHANNEL_ID=1234567890123456789

# ---- LLM: Mistral (free tier) ----
# 1. Sign up at https://console.mistral.ai (free, no card needed)
# 2. Choose the FREE "Experiment" plan when asked
# 3. Go to "API Keys" -> Create new key -> paste it below
# Free-tier models: mistral-small-latest (recommended), open-mistral-nemo
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest

# The API is OpenAI-compatible, so other providers also work if you ever switch:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=llama-3.3-70b-versatile
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.1   (API key can be "ollama")
